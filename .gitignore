# ================================
# MentorNearby — .gitignore
# ================================

# Environment files & Secrets (NEVER commit real credentials)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Local Uploads & Private docs
backend/uploads/
backend/private/
backend/kyc-docs/

# Testing & Coverage
coverage/
.nyc_output/

# Cache & Temporary
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/
scratch/

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
