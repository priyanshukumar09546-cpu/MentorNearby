# ================================================
# MentorNearby Backend — Environment Variables
# ================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
# Get this from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mentornearby?retryWrites=true&w=majority

# ---- JWT ----
# Use a long, random string (min 64 chars)
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
# Optional subdomain cookie sharing (e.g. .mentornearby.com in production)
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# ---- Cloudinary ----
# Get from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Google Cloud OAuth 2.0 (Optional) ----
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Razorpay (Payments) ----
# Development: rzp_test_... from https://dashboard.razorpay.com/app/keys
# Production:  rzp_live_...
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=MentorNearby <noreply@mentornearby.com>

# ---- Frontend URL (for CORS + email verification links) ----
# Development: http://localhost:5173
# Production:  https://mentornearby.com
FRONTEND_URL=http://localhost:5173

# ---- Admin Seed ----
# Used only by initial database seed script: npm run seed
ADMIN_EMAIL=admin@mentornearby.com
ADMIN_PASSWORD=change_this_admin_password_before_deploy
ADMIN_NAME=MentorNearby Admin

# ---- Contact Unlock Pricing ----
# Configurable defaults (can be overridden in AdminConfig DB)
DEFAULT_FREE_UNLOCKS=2
DEFAULT_UNLOCK_PRICE=49

# ---- Rate Limiting ----
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# ---- File Uploads ----
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
