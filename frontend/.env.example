# ================================================
# MentorNearby Frontend — Environment Variables
# ================================================
# Copy to .env and fill in values.
# NEVER commit .env to version control.
#
# Note: All VITE_ variables are included in the frontend bundle.
# NEVER put secrets here. Only PUBLIC keys are safe.

# Backend API URL
# Local Development: http://localhost:5000/api
# Production (Same-Domain / Vercel Serverless / Proxy): /api
# Production (Separate Backend, e.g. Render / Railway): https://your-backend-host.onrender.com/api
VITE_API_URL=/api

# Razorpay PUBLIC key (safe to expose in frontend)
# Development: rzp_test_...
# Production:  rzp_live_... from https://dashboard.razorpay.com/app/keys
# NEVER put RAZORPAY_KEY_SECRET here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
