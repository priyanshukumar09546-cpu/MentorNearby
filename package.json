{
  "name": "tutornearby",
  "version": "1.0.0",
  "description": "MentorNearby — Find Trusted Tutors Near You. Edtech marketplace connecting students with verified tutors.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "npm run build --workspace=frontend",
    "start": "node backend/server.js",
    "start:backend": "cd backend && npm start",
    "seed": "cd backend && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "razorpay": "^2.9.6",
    "slugify": "^1.6.6",
    "streamifier": "^0.1.1",
    "uuid": "^11.1.0"
  },
  "keywords": ["edtech", "tutoring", "marketplace", "india"],
  "author": "MentorNearby Team",
  "license": "UNLICENSED"
}
