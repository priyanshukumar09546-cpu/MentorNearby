{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://mentornearby-2.onrender.com/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://mentornearby-2.onrender.com/health"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://mentornearby-2.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
